{
  "name": "rentigoo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "sandbox": "ampx sandbox --identifier dev",
    "sandbox:deploy": "ampx sandbox --once --identifier dev",
    "sandbox:seed": "set -a && . ./.env.seed && set +a && ampx sandbox seed --identifier dev",
    "check:access": "set -a && . ./.env.seed && set +a && tsx --tsconfig amplify/tsconfig.json scripts/check-access.ts",
    "check:launch": "tsx scripts/check-launch.ts",
    "build:spa": "tsc -b && vite build",
    "preview:static": "node scripts/serve-dist.mjs"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/mukta": "^5.3.0",
    "@hookform/resolvers": "^7.0.5",
    "aws-amplify": "^6.22.2",
    "date-fns": "^4.4.0",
    "framer-motion": "^14.11.1",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.25.1",
    "@aws-amplify/backend-cli": "^1.10.0",
    "@aws-amplify/seed": "^1.1.5",
    "@aws-sdk/client-amplify": "^3.1165.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1165.0",
    "@aws-sdk/client-s3": "^3.1165.0",
    "@aws-sdk/client-sns": "^3.1165.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.8.1",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
